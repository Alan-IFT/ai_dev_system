#!/bin/sh
# 提交闸门（Gate 合同见仓库工作须知 §7）：三道都跑，任一非 0 即拒绝提交，退出码取最大者。安装（每个克隆一次）：git config core.hooksPath .githooks
# 通过时只报一行、失败时只打失败那几道的全量输出：提交的输出会进 agent 上下文，成功路径不该占上下文。
fail=0
for cmd in "python3 tools/std/check_all.py . --no-scope" "python3 docs/附录-载体实例/linkcheck.py" "python3 docs/附录-载体实例/check_normative_force.py"; do
  out=$($cmd 2>&1); rc=$?
  [ $rc -eq 0 ] && continue
  printf '%s\n' "$out"; echo "提交闸门：$cmd 未通过（退出 $rc）" >&2
  [ $rc -gt $fail ] && fail=$rc
done
[ $fail -eq 0 ] && echo "提交闸门：三道通过"
exit $fail
