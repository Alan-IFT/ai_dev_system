#!/bin/sh
# 提交闸门（Gate 合同见仓库工作须知 §7）：四道都跑，任一非 0 即拒绝提交，退出码取最大者。安装（每个克隆一次）：git config core.hooksPath .githooks
# 通过时只报一行、失败时只打失败那几道的全量输出：提交的输出会进 agent 上下文，成功路径不该占上下文。
#
# 全部是 Node（重构设计 §12.38：钩子里不再有 Python）。五道：std-check、check-normative-force、check-lib-sync、check-py-semantics、check-residue。选 node：DSH 导出 DSH_HOME，它的 node 固定在 $DSH_HOME/dsh-runtimes/dsh-primary-runtime/dependencies/node/bin/（重构设计 §4.1 实测）。
# 在 DSH 之外（系统终端手敲 git commit、CI）没有 DSH_HOME：依次回退到 $USERPROFILE/.dsh/ 下同位置的 node（Windows 终端里只有 USERPROFILE），再到 PATH 上的 node；都没有就失败关闭，不当通过（01 §2 N1）。
# 路径含空格（用户名、DSH_HOME 里常见）：解释器路径一律带引号用，不拼进字符串再不加引号展开。
NODE=""
for cand in "${DSH_HOME:+$DSH_HOME/dsh-runtimes/dsh-primary-runtime/dependencies/node/bin/node.exe}" "${DSH_HOME:+$DSH_HOME/dsh-runtimes/dsh-primary-runtime/dependencies/node/bin/node}" "${USERPROFILE:+$USERPROFILE/.dsh/dsh-runtimes/dsh-primary-runtime/dependencies/node/bin/node.exe}" "${USERPROFILE:+$USERPROFILE/.dsh/dsh-runtimes/dsh-primary-runtime/dependencies/node/bin/node}" node; do
  [ -n "$cand" ] || continue
  if "$cand" -e 'process.exit(0)' >/dev/null 2>&1; then NODE="$cand"; break; fi
done
if [ -z "$NODE" ]; then
  echo "提交闸门：找不到能运行的 node（试过 DSH 自带的、\$USERPROFILE/.dsh 下的与 PATH 上的）；本次提交被拒（失败关闭）。" >&2
  exit 127
fi
fail=0
# 一道检查一个函数调用；通过静默，失败打全量输出并记退出码。命令逐个写出，不用分隔符切字符串。
run_gate() {
  label="$1"; shift
  out=$("$@" 2>&1); rc=$?
  [ $rc -eq 0 ] && return 0
  printf '%s\n' "$out"; echo "提交闸门：$label 未通过（退出 $rc）" >&2
  [ $rc -gt $fail ] && fail=$rc
  return 0
}
# 第一道：标准检查器（TS），含链接与锚点（links）。lib/ 已提交进 git，所以直接用本仓的 lib/cli.js——这正是被提交的那一份。
run_gate "std-check（lib/cli.js）" "$NODE" lib/cli.js . --no-scope
# 第二道：本仓自己的元治理自检（效力 C1～C10）。
run_gate "scripts/check-normative-force.mjs" "$NODE" scripts/check-normative-force.mjs
# 第三道：TS 插件包的 lib/ 必须等于从 src/ 构建的结果（重构设计 §4：lib/ 提交进 git，不一致就是没构建就提交）。
if [ -f scripts/check-lib-sync.mjs ]; then
  run_gate "scripts/check-lib-sync.mjs" "$NODE" scripts/check-lib-sync.mjs
fi
# 第四道：src/core 里不得出现偏离 Python 语义的写法，src/checks 与汇总层不得调 process.exit（重构设计 §12.15、§12.31）。
if [ -f scripts/check-py-semantics.mjs ]; then
  run_gate "scripts/check-py-semantics.mjs" "$NODE" scripts/check-py-semantics.mjs
fi
# 第五道：废弃技术栈的字样（口径与白名单见 scripts/check-residue.mjs）只许出现在白名单里（重构设计 §7 阶段 4 的退出判据，§12.38 七）。
if [ -f scripts/check-residue.mjs ]; then
  run_gate "scripts/check-residue.mjs" "$NODE" scripts/check-residue.mjs
fi
[ $fail -eq 0 ] && echo "提交闸门：五道通过"
exit $fail
