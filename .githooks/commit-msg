#!/bin/sh
# 提交信息首行须为 type(scope)!?: subject，scope 可省（01 §5.1，同 Conventional Commits）；git 自动生成的 merge/revert/reapply/fixup/squash/amend 信息放行。
first=$(grep -v '^#' "$1" | grep -m1 -v '^[[:space:]]*$')
printf '%s\n' "$first" | grep -Eq '^(Merge |Revert "|Reapply "|fixup! |squash! |amend! )|^[a-z]+(\([^()]+\))?!?: [^ ]' && exit 0
echo "提交信息首行不合 type(scope)!?: subject（scope 可省，01 §5.1）：$first" >&2
exit 1
