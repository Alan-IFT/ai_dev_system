#!/bin/sh
# 提交信息首行须为 type(scope)!?: subject，scope 可省（01 §5.1，同 Conventional Commits）；git 自动生成的 merge/revert/reapply 信息与 fixup!/squash!/amend! 放行。
# 首行取第一个非空行，不跳过 # 开头的行：-m/-F 的默认 cleanup 不删它们，跳过就会让任意首行进历史；编辑器模式下 git 的提示注释排在信息之后，不受影响；commit.template 以注释行开头、或显式 --cleanup=strip 时会误拒（失败关闭）。
first=$(grep -m1 -v '^[[:space:]]*$' "$1")
printf '%s\n' "$first" | grep -Eq "^Merge ((remote-tracking )?branch(es)?|tags?|commits?) '|^Merge pull request #[0-9]+ from |^Merge [^ ']*[/:][^ ]*( into .+)?\$|^(Revert|Reapply) \".*\"\$|^(fixup|squash|amend)! |^[a-z]+(\([^()]+\))?!?: [^ ]" && exit 0
echo "提交信息首行不合 type(scope)!?: subject（scope 可省，01 §5.1）：$first" >&2
exit 1
