 },
 {
  "id": "Q2",
  "title": "引号：不含单引号时用双引号",
  "file": "src/core/repr.ts",
  "from": "const q = s.includes(\"'\") && !s.includes('\"') ? '\"' : \"'\"",
  "to": "const q = '\"'"
 },
 {
  "id": "Q3",
  "title": "引号：含单引号即用双引号（不管是否含双引号）",
  "file": "src/core/repr.ts",
  "from": "const q = s.includes(\"'\") && !s.includes('\"') ? '\"' : \"'\"",
  "to": "const q = s.includes(\"'\") ? '\"' : \"'\""
 },
 {
  "id": "Q4",
  "title": "引号：判含双引号反了（含双引号时也用双引号）",
  "file": "src/core/repr.ts",
  "from": "const q = s.includes(\"'\") && !s.includes('\"') ? '\"' : \"'\"",
  "to": "const q = s.includes(\"'\") || s.includes('\"') ? '\"' : \"'\""
 },
 {
  "id": "E1",
  "title": "转义：反斜杠不加倍",
  "file": "src/core/repr.ts",
  "from": "if (ch === '\\\\') out += '\\\\\\\\'",
  "to": "if (ch === '\\\\') out += '\\\\'"
 },
 {
  "id": "E2",
  "title": "转义：外层引号不转义",
  "file": "src/core/repr.ts",
  "from": "else if (ch === q) out += '\\\\' + q",
  "to": "else if (false) out += '\\\\' + q"
 },
 {
  "id": "E3",
  "title": "转义：两种引号都转义",
  "file": "src/core/repr.ts",
  "from": "else if (ch === q) out += '\\\\' + q",
  "to": "else if (ch === '\\'' || ch === '\"') out += '\\\\' + ch"
 },
 {
  "id": "E4",
  "title": "转义：换行不转义",
  "file": "src/core/repr.ts",
  "from": "    else if (ch === '\\n') out += '\\\\n'\n",
  "to": ""
 },
 {
  "id": "E5",
  "title": "转义：回车不转义",
  "file": "src/core/repr.ts",
  "from": "    else if (ch === '\\r') out += '\\\\r'\n",
  "to": ""
 },
 {
  "id": "E6",
  "title": "转义：制表符不转义",
  "file": "src/core/repr.ts",
  "from": "    else if (ch === '\\t') out += '\\\\t'\n",
  "to": ""
 },
 {
  "id": "E7",
  "title": "控制字符：不转义 < 0x20",
  "file": "src/core/repr.ts",
  "from": "else if (cp < 0x20) out += '\\\\x' + cp.toString(16).padStart(2, '0')\n    else if (cp < 0x7f) out += ch",
  "to": "else if (cp < 0x7f) out += ch"
 },
 {
  "id": "E9",
  "title": "控制字符：\\x 的十六进制不补零",
  "file": "src/core/repr.ts",
  "from": "out += '\\\\x' + cp.toString(16).padStart(2, '0')\n    else if (cp < 0x7f) out += ch",
  "to": "out += '\\\\x' + cp.toString(16)\n    else if (cp < 0x7f) out += ch"
 },
 {
  "id": "P1",
  "title": "可打印：不可打印字符不转义（全部原样）",
  "file": "src/core/repr.ts",
  "from": "else if (!isPrintable(ch)) out +=",
  "to": "else if (false) out +="
 },
 {
  "id": "P2",
  "title": "可打印：不可打印的判据只看 C* 不看 Z*（U+2028 不转义）",
  "file": "src/core/repr.ts",
  "from": "!/^[\\p{C}\\p{Z}]$/u.test(ch)",
  "to": "!/^[\\p{C}]$/u.test(ch)"
 },
 {
  "id": "P3",
  "title": "可打印：不可打印的判据只看 Z* 不看 C*",
  "file": "src/core/repr.ts",
  "from": "!/^[\\p{C}\\p{Z}]$/u.test(ch)",
  "to": "!/^[\\p{Z}]$/u.test(ch)"
 },
 {
  "id": "P5",
  "title": "可打印：U+00A0（NBSP）当可打印",
  "file": "src/core/repr.ts",
  "from": "const isPrintable = (ch: string): boolean => !/^[\\p{C}\\p{Z}]$/u.test(ch)",
  "to": "const isPrintable = (ch: string): boolean => ch === '\\u00a0' || !/^[\\p{C}\\p{Z}]$/u.test(ch)"
 },
 {
  "id": "W1",
  "title": "转义宽度：≤0xff 也写 \\u",
  "file": "src/core/repr.ts",
  "from": "cp <= 0xff ? '\\\\x' + cp.toString(16).padStart(2, '0') : cp <= 0xffff",
  "to": "cp <= 0xffff"
 },
 {
  "id": "W2",
  "title": "转义宽度：≤0xffff 也写 \\U",
  "file": "src/core/repr.ts",
