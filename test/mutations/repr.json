  "to": "'\\\\u' + cp.toString(16)"
 },
 {
  "id": "W4",
  "title": "转义宽度：\\U 不补零到 8 位",
  "file": "src/core/repr.ts",
  "from": "'\\\\U' + cp.toString(16).padStart(8, '0')",
  "to": "'\\\\U' + cp.toString(16)"
 },
 {
  "id": "W5",
  "title": "转义：十六进制用大写",
  "file": "src/core/repr.ts",
  "from": "'\\\\u' + cp.toString(16).padStart(4, '0')",
  "to": "'\\\\u' + cp.toString(16).toUpperCase().padStart(4, '0')"
 },
 {
  "id": "W6",
  "title": "遍历：按码元而不是码点（非 BMP 字符被拆）",
  "file": "src/core/repr.ts",
  "from": "  for (const ch of s) {\n    const cp = ch.codePointAt(0)!",
  "to": "  for (const ch of s.split('')) {\n    const cp = ch.codePointAt(0)!"
 },
 {
