 {"id":"R15","title":"扩展名过滤去掉 .json（变异清单里的字样漏检）","file":"scripts/check-residue.mjs","from":"/\\.(md|ts|mjs|js|json|yaml|yml|sh|txt)$|","to":"/\\.(md|ts|mjs|js|yaml|yml|sh|txt)$|"},
