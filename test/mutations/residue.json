 {"id":"R17","title":"扩展名过滤去掉 .gitignore","file":"scripts/check-residue.mjs","from":"|(^|\\/)\\.gitignore$/.test(f)","to":"/.test(f)"},
 {"id":"R18","title":"只报第一个命中的文件就退出（多文件要报全）","file":"scripts/check-residue.mjs","from":"  outside.push([f, hits.length, lines])\n","to":"  outside.push([f, hits.length, lines])\n  break\n"},
